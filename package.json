{
  "name": "parkly",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5180",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "ml:setup": "python3 -m venv ml/.venv && ml/.venv/bin/pip install -r ml/requirements.txt",
    "ml:meta": "vitest run --config ml/vitest.ml.config.ts ml/export-meta.task.ts",
    "ml:train": "ml/.venv/bin/python ml/train.py",
    "ml:compare": "vitest run --config ml/vitest.ml.config.ts ml/compare.task.ts",
    "ml:arrivals": "vitest run --config ml/vitest.ml.config.ts ml/arrivals.task.ts",
    "ml:intent": "vitest run --config ml/vitest.ml.config.ts ml/intent.task.ts",
    "ml": "npm run ml:meta && npm run ml:train && npm run ml:compare && npm run ml:arrivals",
    "catalog:setup": "python3 -m venv catalog/.venv && catalog/.venv/bin/pip install -r catalog/requirements.txt",
    "catalog": "catalog/.venv/bin/python -I catalog/import.py",
    "icons": "bash scripts/make-icons.sh",
    "release:test": "bash scripts/make-test-release.sh",
    "release:test-server": "node scripts/release-test-server.mjs",
    "android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "release": "bash scripts/publish-release.sh",
    "pilot:import": "node scripts/import-measurements.ts",
    "anchors": "catalog/.venv/bin/python -I catalog/anchor_demo.py"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "6.0.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
